{
    "version": 2,
    "builds": [
        {
            "src": "backend/nuruhub_api/wsgi.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "dist" }
        }
    ],

    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/nuruhub_api/wsgi.py"
        },
        {
       "src" : "/assets/(.*)",
       "dest" : "frontend/assets/$1" ,
       "check": true
    },
        {
            "src": "/(.*)",
            "status": 200 ,
            "dest": "frontend/$1"
        }
    ]
}